/* Baseline space for all sidebar items */
.sidebar nav[role="navigation"] .sidebar-item {
  margin-top: 0.3rem;
  margin-bottom: 0.3rem;
}

/* Force an structural break directly below the "creative" entry link */
.sidebar nav[role="navigation"] .sidebar-item:has(a[href*="creative.html"]) {
  margin-bottom: 2.2rem; /* 2 to 4 times the base padding */
}

/* Force a structural break directly below the "academic.qmd" entry link */
.sidebar nav[role="navigation"] .sidebar-item:has(a[href*="academic.html"]) {
  margin-bottom: 2.2rem;
}
